// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] // Enable pgvector
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model Creator {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auth tokens for ingestion
  authConnections PlatformConnection[]

  // The generated Digital Twin
  persona PersonaProfile?

  // Ingested Data
  contents ContentItem[]
  
  // Chat Sessions
  chatSessions ChatSession[]

  // Voice Enrollment (Golden Sample)
  voiceSample String? // Path to local file
  voiceStatus String? @default("MISSING") // MISSING, ENROLLED
}

model PlatformConnection {
  id        String   @id @default(uuid())
  platform  String   // "YOUTUBE", "INSTAGRAM"
  accessToken String
  refreshToken String?
  expiresAt DateTime?
  
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id])
}

model PersonaProfile {
  id        String   @id @default(uuid())
  creatorId String   @unique
  creator   Creator  @relation(fields: [creatorId], references: [id])

  // Extracted "Mind"
  tone      String?  // "Sarcastic, Fast-paced"
  keywords  String[] // ["Tech", "Keyboards"]
  facts     PersonaFact[]
  
  backgroundStory String? @db.Text // Generated via Perplexity
  
  // Voice Config
  voiceTier String   @default("TIER_1") // TIER_1 (Embedding) | TIER_2 (LoRA)
  voiceRef  String?  // Path to embedding or LoRA adapter ID

  updatedAt DateTime @updatedAt
}

model PersonaFact {
  id        String   @id @default(uuid())
  profileId String
  profile   PersonaProfile @relation(fields: [profileId], references: [id])

  content   String   @db.Text
  status    String   @default("ALLOWED") // ALLOWED, FORBIDDEN, EDITED
  isManual  Boolean  @default(false)
  
  sourceMetadata Json? // { type: "youtube", id: "...", url: "..." }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

model ContentItem {
  id          String   @id @default(uuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id])
  
  platform    String   // "YOUTUBE", "INSTAGRAM"
  externalId  String   // YouTube Video ID, IG Post ID
  
  title       String?
  description String?
  publishedAt DateTime?

  // For YouTube
  transcript  String?  @db.Text
  audioPath   String?  // /storage/audio/vid_123.wav

  // For IG
  imagePath   String?
  caption     String?
  
  // New Fields for Queue & UI
  thumbnail   String?
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  diarization Json?

  // Engagement
  comments    Comment[]

  // RAG Chunks
  embeddings  MemoryChunk[]

  @@index([creatorId])
}

model Comment {
  id            String   @id @default(uuid())
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id])
  
  authorName    String
  text          String   @db.Text
  
  // Did the creator reply? (For learning reply style)
  creatorReply  String?  @db.Text
}

model MemoryChunk {
  id            String   @id @default(uuid())
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id])

  content       String   @db.Text
  embedding     Unsupported("vector(384)")? // Xenova/all-MiniLM-L6-v2 embedding size
  importance    Int      @default(3) // 1-10 scale for RIR scoring
  createdAt     DateTime @default(now())

  @@index([contentItemId])
}

// --- Chat & Connections ---

model Fan {
  id        String   @id @default(uuid())
  email     String?  // Optional for anon/web users
  fingerprint String? // Browser fingerprint or device ID
  
  // Relations
  chatSessions ChatSession[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatSession {
  id        String   @id @default(uuid())
  
  fanId     String
  fan       Fan      @relation(fields: [fanId], references: [id])
  
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id])
  
  messages  Message[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id            String   @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id])
  
  role          String   // "USER", "ASSISTANT"
  content       String?  @db.Text
  
  // Audio
  audioUrl      String?  // Supabase URL to compressed audio
  durationSec   Float?
  
  createdAt     DateTime @default(now())
}
