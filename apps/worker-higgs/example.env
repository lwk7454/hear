# Service: Hear Higgs Worker (Voice Cloning & TTS)
# Copy this file to .env and fill in the values

# --- Supabase Connectivity ---
# Required for fetching Master Voice references and storing generated Chat Audio.
# This KEY should be the SERVICE_ROLE_KEY (admin) to allow storage operations and DB updates.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey...

# --- Higgs / Boson AI Configuration ---
# Path to the Higgs V2 model and tokenizer (HuggingFace ID or Local Path)
HIGGS_MODEL_PATH=bosonai/higgs-audio-v2-generation-3B-base
HIGGS_TOKENIZER_PATH=bosonai/higgs-audio-v2-tokenizer

# Optimizations
# Set to 'true' if running on consumer GPU (e.g. RTX 4090/3090, T4) to save VRAM.
# Note: 8-bit quantization disables CUDA graph capture but uses less memory.
USE_8BIT=true

# KV Cache Size (in tokens) - Controls VRAM usage for attention caching
# Default: 2048 (good for 12GB VRAM). Increase to 4096 or 8192 if you have 24GB+ VRAM.
# Smaller values = less VRAM but shorter max conversation context.
KV_CACHE_SIZE=2048

# --- Storage Configuration ---
# Directory to store persistent Voice Caches (.pt) and temporary WAVs.
# Should be a writable path. Defaults to system /tmp/higgs_cache if unset.
CACHE_DIR=/tmp/higgs_cache

# --- Testing / Development ---
# Set to 'true' to run without loading the heavy model (returns silence/dummy data).
# Useful for testing API connectivity and database logic without a GPU.
MOCK_MODEL=false

# --- Deployment ---
# GitHub Personal Access Token (Classic) with 'write:packages' scope for automated docker login
# GHCR_PAT=your_pat_here

ENV=development