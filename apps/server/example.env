# Service: Hear API Server (Node.js/Fastify)
# Copy this file to .env

# --- Server Config ---
PORT=8000
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# --- Security ---
JWT_SECRET=supersecret123
COOKIE_SECRET=another-secret-123
ADMIN_EMAILS=lwk7454@gmail.com

# --- Supabase Identity & Storage ---
SUPABASE_URL=https://your-project.supabase.co
# Service Key required for admin operations (storage management)
SUPABASE_SERVICE_KEY=ey...

# --- OAuth: Google / YouTube ---
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/auth/google/callback
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...
# Redirect URI for YouTube Data API (Ingestion)
YOUTUBE_REDIRECT_URI=http://localhost:8000/auth/youtube/callback
# Optional: Path to Netscape cookies file for yt-dlp fallback
YOUTUBE_COOKIES_PATH=

# --- OAuth: Instagram ---
IG_CLIENT_ID=...
IG_CLIENT_SECRET=...
IG_REDIRECT_URI=http://localhost:8000/auth/instagram/callback

# --- AI Services ---
# URL of the Cleansing Worker (Diarization)
WORKER_URL=http://127.0.0.1:8001
# URL of the Higgs Worker (Voice Cloning & TTS)
HIGGS_API_URL=http://localhost:8002
HIGGS_TIMEOUT=300000


# --- LLM Service ---
LLM_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
# --- Chat Config ---
# Set to 'true' to automatically generate voice for every chat response
ENABLE_AUTO_TTS=true
